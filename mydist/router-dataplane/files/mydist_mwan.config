config global 'global'
	# Off by default: a single-WAN box must behave exactly as before until the
	# operator (or the LuCI page) turns multi-WAN on.
	option enabled '0'
	option health_interval '5'

# One section per uplink. `interface` is the netifd interface (wan, wan2, ...);
# the device is resolved at runtime, so PPPoE works without naming pppoe-wan.
#
#config wan 'wan'
#	option interface 'wan'
#	option weight '1'
#	option enabled '1'
#	option health '1.1.1.1'
#
#config wan 'wan2'
#	option interface 'wan2'
#	option weight '1'
#	option enabled '1'
#	option health '1.1.1.1'
